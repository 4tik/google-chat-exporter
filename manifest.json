{
  "manifest_version": 3,
  "name": "ChatVault - Google Chat Exporter & Archiver",
  "version": "1.2.0",
  "description": "Export and archive Google Chat conversations, spaces, threads, media, and attachments to HTML, PDF, and ZIP.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatVault - Google Chat Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "jszip.min.js",
        "jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
