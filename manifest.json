{
  "manifest_version": 3,
  "name": "Google Chat Exporter",
  "version": "2.0.0",
  "description": "Export Google Chat conversations, spaces, direct messages, and independent threads to HTML, PDF, and JSON.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Chat Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "jszip.min.js",
        "jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
